NODE_ENV=development
WEB_URL=http://localhost:3001
API_URL=http://localhost:4000
API_HOST_PORT=4000
WEB_HOST_PORT=3001
DATABASE_URL=postgresql://reparto:reparto_local@localhost:5432/reparto?schema=public
# Usadas por Docker Compose; cambiar juntas en producción. Elegir contraseña URL-safe.
POSTGRES_DB=reparto
POSTGRES_USER=reparto
POSTGRES_PASSWORD=reparto_local
REDIS_URL=redis://localhost:6379
AUTH_SECRET=replace_with_32_or_more_random_characters
COOKIE_SECRET=replace_with_another_32_or_more_random_characters
ADMIN_INICIAL_CORREO=admin@local.test
ADMIN_INICIAL_PASSWORD=
PUERTO_API=4000

# ==================================================
# WHATSAPP
# ==================================================
# mock | meta
WHATSAPP_MODE=mock
# Versión de Graph API, configurable en un solo lugar
META_GRAPH_API_VERSION=
# Token del System User / Access Token para WhatsApp Cloud API
META_WHATSAPP_ACCESS_TOKEN=
# Solo compatibilidad con el flujo V1 legado. En V2 cada canal guarda su Phone Number ID no secreto en PostgreSQL.
META_WHATSAPP_PHONE_NUMBER_ID=
# Solo compatibilidad V1. En V2 cada canal guarda su WABA ID no secreto en PostgreSQL.
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
# App Secret de la aplicación de Meta
META_APP_SECRET=
# Token que nosotros definimos para verificar el webhook
META_WEBHOOK_VERIFY_TOKEN=
# Opcional, solo informativo
META_BUSINESS_PORTFOLIO_ID=
# Número visible de la empresa, opcional en UI
WHATSAPP_BUSINESS_DISPLAY_NUMBER=
